<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/notification_portrait" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="세로" android:textSize="15sp" android:textStyle="bold" android:textColor="#F6F4FF" android:background="@drawable/notification_unselected" android:maxLines="1" android:ellipsize="end" android:contentDescription="외부 모니터 세로 방향으로 즉시 전환" />
    <TextView android:id="@+id/notification_landscape" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="가로" android:textSize="15sp" android:textStyle="bold" android:textColor="#F6F4FF" android:background="@drawable/notification_unselected" android:maxLines="1" android:ellipsize="end" android:contentDescription="외부 모니터 가로 방향으로 즉시 전환" />
    <TextView android:id="@+id/notification_stop" android:layout_width="64dp" android:layout_height="48dp" android:gravity="center" android:text="종료" android:textSize="14sp" android:textColor="#FFC4D0" android:background="@drawable/notification_stop" android:maxLines="1" android:contentDescription="화면 복제 종료" />
</LinearLayout>
