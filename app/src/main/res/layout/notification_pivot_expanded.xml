<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include layout="@layout/notification_pivot" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/notification_edit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:background="@drawable/notification_unselected" android:textColor="#F6F4FF" android:textSize="13sp" android:text="테두리 편집" />
        <TextView android:id="@+id/notification_guide" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/notification_unselected" android:textColor="#F6F4FF" android:textSize="13sp" android:text="테두리 표시" />
        <TextView android:id="@+id/notification_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/notification_unselected" android:textColor="#F6F4FF" android:textSize="13sp" android:text="일시정지" />
    </LinearLayout>
    <TextView android:id="@+id/notification_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="앱을 열지 않고 바로 전환할 수 있어요" android:textSize="12sp" android:maxLines="2" />
</LinearLayout>
